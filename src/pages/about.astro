---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import fs from 'fs';
import path from 'path';

const jsonPath = path.join(process.cwd(), 'src/data/techmap.json');
const techmap = JSON.parse(fs.readFileSync(jsonPath, 'utf-8'));
---

<BaseLayout title="About">
  <div class="max-w-2xl">
    <h1 class="text-3xl font-bold mb-6" style="color: var(--text-heading);">About</h1>

    <div class="card mb-6">
      <div class="flex items-center gap-4 mb-4">
        <div class="w-14 h-14 rounded-full flex items-center justify-center text-2xl font-bold"
          style="background: var(--accent-glow); border: 2px solid var(--accent); color: var(--accent);">B</div>
        <div>
          <h2 class="text-lg font-semibold" style="color: var(--text-heading);">BubbleStone</h2>
          <p class="text-sm" style="color: var(--text-muted);">Developer & Builder</p>
        </div>
      </div>
      <p class="text-sm leading-relaxed" style="color: var(--text-muted);">
        개발을 좋아하고, 만드는 것을 좋아합니다. 웹 서비스, 자동화 시스템, AI 연동 등 다양한 것들을 직접 만들어보며 배우고 있습니다.
        이 블로그는 그 과정에서 배운 것들을 기록하는 공간입니다.
      </p>
    </div>

    <div class="card mb-6">
      <h3 class="text-sm font-semibold mb-4" style="color: var(--text-heading);">Contact</h3>
      <div class="space-y-2 text-sm" style="color: var(--text-muted);">
        <p>· GitHub: <a href="https://github.com/bubbleStone" class="transition-colors hover:opacity-80" style="color: var(--accent);">@bubbleStone</a></p>
        <p>· Blog: <a href="https://blog.naver.com/bubble_money" class="transition-colors hover:opacity-80" style="color: var(--accent);">Naver Blog</a></p>
      </div>
    </div>

    <h2 class="text-base font-semibold mb-4" style="color: var(--text-heading);">Tech Stack</h2>
    <div class="space-y-3">
      {techmap.map((group: any) => (
        <div class="rounded-xl overflow-hidden" style="background: var(--bg-2); border: 1px solid var(--border); box-shadow: var(--card-shadow);">
          <div class="flex items-center gap-2 px-4 py-3" style="border-bottom: 1px solid var(--border);">
            <span class="w-2 h-2 rounded-full flex-shrink-0" style={`background: ${group.color}`}></span>
            <span class="text-xs font-bold tracking-widest uppercase" style={`color: ${group.color}`}>{group.label}</span>
            <span class="text-xs font-mono px-1.5 py-0.5 rounded" style="background: var(--bg-3); color: var(--text-muted);">{group.items.length}</span>
          </div>
          <div class="p-3 flex flex-wrap gap-2">
            {group.items.map((item: any) => (
              <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium"
                style={`background: ${group.color}15; color: ${group.color}; border: 1px solid ${group.color}25;`}>
                <span class="font-mono">{item.icon}</span>
                {item.name}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>
