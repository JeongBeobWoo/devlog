---
import BaseLayout from '../layouts/BaseLayout.astro';
import TechGraph from '../components/TechGraph.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts'))
  .sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf())
  .slice(0, 5);
---

<BaseLayout title="Home">
  <!-- Hero -->
  <section class="mb-14 pt-4">
    <p class="font-mono text-sm mb-3" style="color: var(--accent);">$ whoami</p>
    <h1 class="text-4xl font-bold mb-4" style="color: var(--text-heading);">BubbleStone DevLog</h1>
    <p class="text-lg leading-relaxed max-w-xl" style="color: var(--text-muted);">
      개발 경험, 아키텍처 설계, 자동화 — 직접 만들고 부딪힌 것들을 기록합니다.
    </p>
  </section>

  <!-- Tech Map -->
  <section class="mb-14">
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-lg font-semibold flex items-center gap-2" style="color: var(--text-heading);">
        <span style="color: var(--accent);">◆</span> Tech Map
      </h2>
      <a href="/tech" class="text-sm transition-colors hover:opacity-80" style="color: var(--text-muted);">전체 보기 →</a>
    </div>
    <p class="text-sm mb-4" style="color: var(--text-muted);">드래그로 이동 · 스크롤로 확대/축소 · 노드에 마우스를 올리면 설명이 보입니다</p>
    <TechGraph />
  </section>

  <!-- Recent Posts -->
  <section>
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-lg font-semibold flex items-center gap-2" style="color: var(--text-heading);">
        <span style="color: var(--accent);">◆</span> Recent Posts
      </h2>
      <a href="/posts" class="text-sm transition-colors hover:opacity-80" style="color: var(--text-muted);">모두 보기 →</a>
    </div>

    <div class="space-y-4">
      {posts.map(post => (
        <a href={`/posts/${post.id}`} class="card block group">
          <div class="flex flex-wrap gap-2 mb-2">
            {(post.data.tags ?? []).slice(0, 3).map((tag: string) => (
              <span class="tag-badge">{tag}</span>
            ))}
          </div>
          <h3 class="text-base font-semibold group-hover:text-[var(--accent)] transition-colors mb-1" style="color: var(--text-heading);">
            {post.data.title}
          </h3>
          <p class="text-sm line-clamp-2 mb-3" style="color: var(--text-muted);">{post.data.description}</p>
          <p class="text-xs font-mono" style="color: var(--text-muted);">
            {new Date(post.data.date).toLocaleDateString('ko-KR')}
          </p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
