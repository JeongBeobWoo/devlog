---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('posts');
const tagMap = new Map<string, number>();
for (const post of posts) {
  for (const tag of post.data.tags ?? []) {
    tagMap.set(tag, (tagMap.get(tag) ?? 0) + 1);
  }
}
const tags = [...tagMap.entries()].sort((a, b) => b[1] - a[1]);
---

<BaseLayout title="Tags">
  <div class="mb-8">
    <h1 class="text-2xl font-bold mb-2" style="color: var(--text-heading);">Tags</h1>
    <p class="text-sm" style="color: var(--text-muted);">{tags.length}개의 태그</p>
  </div>

  <div class="flex flex-wrap gap-3">
    {tags.map(([tag, count]) => (
      <a href={`/tags/${tag}`}
        class="flex items-center gap-2 px-4 py-2 rounded-lg transition-all duration-200"
        style="background: var(--bg-2); border: 1px solid var(--border);"
        onmouseover="this.style.borderColor='var(--accent)'"
        onmouseout="this.style.borderColor='var(--border)'">
        <span class="text-sm font-mono" style="color: var(--accent);">#</span>
        <span class="text-sm" style="color: var(--text-heading);">{tag}</span>
        <span class="text-xs font-mono px-1.5 py-0.5 rounded" style="background: var(--bg-3); color: var(--text-muted);">{count}</span>
      </a>
    ))}
  </div>
</BaseLayout>
