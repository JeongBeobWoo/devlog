---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Tech Map" description="사용 기술들의 스택을 카테고리별로 정리합니다">

  <div class="mb-10">
    <h1 class="text-2xl font-bold mb-2" style="color: var(--text-heading);">Tech Map</h1>
    <p class="text-sm" style="color: var(--text-muted);">드래그로 순서를 바꿀 수 있습니다</p>
  </div>

  <div id="tech-board" class="space-y-3"></div>

</BaseLayout>

<style>
  /* 배지 삽입 위치 인디케이터 */
  .drop-indicator {
    width: 2px;
    height: 32px;
    border-radius: 2px;
    background: var(--accent);
    flex-shrink: 0;
    pointer-events: none;
    animation: pulse-indicator 0.8s ease-in-out infinite alternate;
  }
  @keyframes pulse-indicator {
    from { opacity: 0.6; }
    to   { opacity: 1; }
  }

  /* 카테고리 섹션 삽입 위치 인디케이터 */
  .section-drop-line {
    height: 2px;
    border-radius: 2px;
    background: var(--accent);
    margin: 2px 0;
    pointer-events: none;
    animation: pulse-indicator 0.8s ease-in-out infinite alternate;
  }

  /* 드래그 중인 배지 */
  .tech-badge.dragging {
    opacity: 0.35;
    transform: scale(0.95);
  }

  /* 드래그 받는 카테고리 하이라이트 */
  .items-grid.drag-over {
    background: var(--accent);
    opacity: 0.04;
    border-radius: 0.5rem;
  }

  /* 카테고리 드래그 중 */
  .tech-section.dragging {
    opacity: 0.4;
  }

  /* 카테고리 드래그 받는 위치 */
  .tech-section.section-over-top {
    border-top: 2px solid var(--accent) !important;
  }
  .tech-section.section-over-bottom {
    border-bottom: 2px solid var(--accent) !important;
  }
</style>

<script>
const STORAGE_KEY = 'techmap-v1';

const defaultData = [
  {
    id: 'frontend', label: 'Frontend', color: '#6366f1', open: true,
    items: [
      { id: 'react',      icon: '⚛',  name: 'React' },
      { id: 'nextjs',     icon: '▲',  name: 'Next.js' },
      { id: 'typescript', icon: 'TS', name: 'TypeScript' },
      { id: 'tailwind',   icon: '💨', name: 'Tailwind' },
      { id: 'astro',      icon: '🚀', name: 'Astro' },
    ],
  },
  {
    id: 'backend', label: 'Backend', color: '#10b981', open: true,
    items: [
      { id: 'nodejs',     icon: '⬡',  name: 'Node.js' },
      { id: 'fastapi',    icon: 'FA', name: 'FastAPI' },
      { id: 'postgresql', icon: 'PG', name: 'PostgreSQL' },
      { id: 'redis',      icon: '⚡', name: 'Redis' },
    ],
  },
  {
    id: 'infra', label: 'Infra', color: '#f59e0b', open: true,
    items: [
      { id: 'docker',    icon: '🐳', name: 'Docker' },
      { id: 'nginx',     icon: 'NX', name: 'Nginx' },
      { id: 'ghactions', icon: '⚙',  name: 'GitHub Actions' },
    ],
  },
  {
    id: 'ai', label: 'AI / Tools', color: '#ec4899', open: true,
    items: [
      { id: 'claude',     icon: '◆',  name: 'Claude API' },
      { id: 'gemini',     icon: '✦',  name: 'Gemini API' },
      { id: 'playwright', icon: '🎭', name: 'Playwright' },
    ],
  },
];

function loadState() {
  try {
    const saved = localStorage.getItem(STORAGE_KEY);
    if (saved) return JSON.parse(saved);
  } catch {}
  return defaultData;
}
function saveState(data) {
  localStorage.setItem(STORAGE_KEY, JSON.stringify(data));
}

let state = loadState();
const board = document.getElementById('tech-board');

// ── 인디케이터 헬퍼 ───────────────────────────────────────────────────────────
function makeIndicator() {
  const el = document.createElement('div');
  el.className = 'drop-indicator';
  return el;
}

function clearIndicators() {
  document.querySelectorAll('.drop-indicator').forEach(el => el.remove());
  document.querySelectorAll('.tech-section').forEach(el => {
    el.classList.remove('section-over-top', 'section-over-bottom');
  });
}

// ── render ────────────────────────────────────────────────────────────────────
function render() {
  board.innerHTML = '';

  state.forEach((group, gi) => {
    const section = document.createElement('div');
    section.className = 'tech-section rounded-xl overflow-hidden';
    section.style.cssText = `background: var(--bg-2); border: 1px solid var(--border); box-shadow: var(--card-shadow); transition: border-color .15s;`;
    section.dataset.gi = gi;

    // header
    const header = document.createElement('div');
    header.className = 'tech-header flex items-center justify-between px-4 py-3 cursor-pointer select-none';
    header.style.cssText = `border-bottom: ${group.open ? '1px solid var(--border)' : 'none'};`;
    header.innerHTML = `
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full flex-shrink-0" style="background:${group.color}"></span>
        <span class="text-sm font-bold tracking-wide uppercase" style="color:${group.color}">${group.label}</span>
        <span class="text-xs font-mono px-1.5 py-0.5 rounded" style="background:var(--bg-3);color:var(--text-muted);">${group.items.length}</span>
      </div>
      <span style="color:var(--text-muted);font-size:0.7rem;transform:rotate(${group.open ? 0 : -90}deg);display:inline-block;transition:transform .2s;">▼</span>
    `;
    header.addEventListener('click', () => {
      state[gi].open = !state[gi].open;
      saveState(state);
      render();
    });
    section.appendChild(header);

    // items grid
    if (group.open) {
      const grid = document.createElement('div');
      grid.className = 'items-grid p-3 flex flex-wrap gap-2 min-h-[48px]';
      grid.dataset.gi = gi;

      group.items.forEach((item, ii) => {
        const badge = document.createElement('div');
        badge.className = 'tech-badge flex items-center gap-1.5 px-3 py-2 rounded-lg text-sm font-medium cursor-grab active:cursor-grabbing select-none';
        badge.style.cssText = `background:${group.color}15; color:${group.color}; border:1px solid ${group.color}25; transition: opacity .15s, transform .15s;`;
        badge.draggable = true;
        badge.dataset.gi = gi;
        badge.dataset.ii = ii;
        badge.innerHTML = `<span class="font-mono text-xs">${item.icon}</span><span>${item.name}</span>`;

        badge.addEventListener('dragstart', onItemDragStart);
        badge.addEventListener('dragend',   onItemDragEnd);
        badge.addEventListener('dragover',  onItemDragOver);
        badge.addEventListener('drop',      onItemDrop);

        grid.appendChild(badge);
      });

      // 빈 그리드에 드롭
      grid.addEventListener('dragover', onGridDragOver);
      grid.addEventListener('dragleave', onGridDragLeave);
      grid.addEventListener('drop', onGridDrop);

      section.appendChild(grid);
    }

    // section-level drag (카테고리 순서)
    section.draggable = true;
    section.addEventListener('dragstart', onSectionDragStart);
    section.addEventListener('dragend',   onSectionDragEnd);
    section.addEventListener('dragover',  onSectionDragOver);
    section.addEventListener('dragleave', onSectionDragLeave);
    section.addEventListener('drop',      onSectionDrop);

    board.appendChild(section);
  });
}

// ── item drag ────────────────────────────────────────────────────────────────
let itemDrag = null; // { gi, ii }

function onItemDragStart(e) {
  itemDrag = { gi: +e.currentTarget.dataset.gi, ii: +e.currentTarget.dataset.ii };
  e.currentTarget.classList.add('dragging');
  e.dataTransfer.effectAllowed = 'move';
  e.stopPropagation(); // 섹션 드래그 차단
}

function onItemDragEnd(e) {
  e.currentTarget.classList.remove('dragging');
  clearIndicators();
  itemDrag = null;
}

function onItemDragOver(e) {
  if (!itemDrag) return;
  e.preventDefault();
  e.stopPropagation();
  e.dataTransfer.dropEffect = 'move';

  clearIndicators();

  const badge = e.currentTarget;
  const rect  = badge.getBoundingClientRect();
  const mid   = rect.left + rect.width / 2;
  const insertBefore = e.clientX < mid;

  const indicator = makeIndicator();
  if (insertBefore) {
    badge.parentNode.insertBefore(indicator, badge);
  } else {
    badge.parentNode.insertBefore(indicator, badge.nextSibling);
  }
}

function onItemDrop(e) {
  e.stopPropagation();
  if (!itemDrag) return;

  const tgi = +e.currentTarget.dataset.gi;
  const tii = +e.currentTarget.dataset.ii;

  // 삽입 위치: 마우스가 배지 왼쪽/오른쪽
  const rect = e.currentTarget.getBoundingClientRect();
  const insertBefore = e.clientX < rect.left + rect.width / 2;

  const [item] = state[itemDrag.gi].items.splice(itemDrag.ii, 1);

  // 같은 그룹이면 splice 위치 재계산
  let insertIdx = tii;
  if (itemDrag.gi === tgi && itemDrag.ii < tii) insertIdx = tii - 1;
  if (!insertBefore) insertIdx += 1;

  state[tgi].items.splice(Math.max(0, insertIdx), 0, item);

  saveState(state);
  render();
}

function onGridDragOver(e) {
  if (!itemDrag) return;
  const grid = e.currentTarget;
  // 배지 위에서 발생한 이벤트는 badge의 dragover가 처리
  if (e.target !== grid) return;
  e.preventDefault();
  e.stopPropagation();
  clearIndicators();
  grid.classList.add('drag-over');
}

function onGridDragLeave(e) {
  e.currentTarget.classList.remove('drag-over');
}

function onGridDrop(e) {
  if (!itemDrag) return;
  const grid = e.currentTarget;
  if (e.target !== grid) return; // 배지 위 드롭은 onItemDrop이 처리
  e.stopPropagation();
  grid.classList.remove('drag-over');
  clearIndicators();

  const tgi = +grid.dataset.gi;
  const [item] = state[itemDrag.gi].items.splice(itemDrag.ii, 1);
  state[tgi].items.push(item);
  saveState(state);
  render();
}

// ── section drag ──────────────────────────────────────────────────────────────
let sectionDrag = null;

function onSectionDragStart(e) {
  if (itemDrag) return;
  sectionDrag = +e.currentTarget.dataset.gi;
  e.currentTarget.classList.add('dragging');
  e.dataTransfer.effectAllowed = 'move';
}

function onSectionDragEnd(e) {
  e.currentTarget.classList.remove('dragging');
  clearIndicators();
  sectionDrag = null;
}

function onSectionDragOver(e) {
  if (sectionDrag === null || itemDrag) return;
  e.preventDefault();
  e.dataTransfer.dropEffect = 'move';

  clearIndicators();

  const section = e.currentTarget;
  const rect = section.getBoundingClientRect();
  const mid  = rect.top + rect.height / 2;

  if (e.clientY < mid) {
    section.classList.add('section-over-top');
  } else {
    section.classList.add('section-over-bottom');
  }
}

function onSectionDragLeave(e) {
  // 자식 요소로 이동 시 무시
  if (e.currentTarget.contains(e.relatedTarget)) return;
  e.currentTarget.classList.remove('section-over-top', 'section-over-bottom');
}

function onSectionDrop(e) {
  if (sectionDrag === null) return;
  e.stopPropagation();

  const tgi  = +e.currentTarget.dataset.gi;
  const rect = e.currentTarget.getBoundingClientRect();
  const insertBefore = e.clientY < rect.top + rect.height / 2;

  clearIndicators();

  if (sectionDrag === tgi) return;

  const [group] = state.splice(sectionDrag, 1);
  let insertIdx = tgi;
  if (sectionDrag < tgi) insertIdx = tgi - 1;
  if (!insertBefore) insertIdx += 1;

  state.splice(Math.max(0, insertIdx), 0, group);
  saveState(state);
  render();
}

render();
</script>
