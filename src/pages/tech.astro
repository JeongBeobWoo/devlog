---
import BaseLayout from '../layouts/BaseLayout.astro';

const techData = {
  frontend: [
    { icon: '⚛', name: 'React',      desc: '컴포넌트 기반 UI 라이브러리',      level: 80 },
    { icon: '▲', name: 'Next.js',    desc: 'SSR/SSG 풀스택 프레임워크',        level: 72 },
    { icon: 'TS', name: 'TypeScript', desc: '정적 타입으로 안정성 확보',         level: 75 },
    { icon: '💨', name: 'Tailwind',   desc: '유틸리티 CSS 프레임워크',          level: 85 },
    { icon: '🚀', name: 'Astro',      desc: '이 블로그 포함 정적 사이트 생성기', level: 60 },
  ],
  backend: [
    { icon: '⬡', name: 'Node.js',    desc: 'JS 서버 런타임',            level: 70 },
    { icon: 'FA', name: 'FastAPI',    desc: 'Python 비동기 API 서버',    level: 65 },
    { icon: 'PG', name: 'PostgreSQL', desc: '주요 관계형 데이터베이스',   level: 70 },
    { icon: '⚡', name: 'Redis',      desc: '인메모리 캐시 / 작업 큐',   level: 55 },
  ],
  infra: [
    { icon: '🐳', name: 'Docker',          desc: '모든 서비스 컨테이너화',     level: 72 },
    { icon: 'NX', name: 'Nginx',           desc: '리버스 프록시 / 웹서버',     level: 60 },
    { icon: '⚙',  name: 'GitHub Actions',  desc: 'CI/CD 자동화 파이프라인',   level: 68 },
  ],
  ai: [
    { icon: '◆', name: 'Claude API',  desc: 'Anthropic LLM API',      level: 78 },
    { icon: '✦', name: 'Gemini API',  desc: 'Google 멀티모달 AI',      level: 55 },
    { icon: '🎭', name: 'Playwright', desc: '브라우저 자동화 / 스크래핑', level: 65 },
  ],
};

const groupMeta = {
  frontend: { label: 'Frontend', color: '#6366f1' },
  backend:  { label: 'Backend',  color: '#10b981' },
  infra:    { label: 'Infra',    color: '#f59e0b' },
  ai:       { label: 'AI / Tools', color: '#ec4899' },
};
---

<BaseLayout title="Tech Map" description="사용 기술들의 스택과 숙련도를 정리합니다">

  <!-- 상단 헤더 -->
  <div class="mb-10">
    <h1 class="text-2xl font-bold mb-2" style="color: var(--text-heading);">Tech Map</h1>
    <p class="text-sm" style="color: var(--text-muted);">사용하는 기술 스택과 숙련도를 카테고리별로 정리했습니다</p>
  </div>

  <!-- ── 스타일 A: 그리드 카드 ── -->
  <section class="mb-16">
    <div class="flex items-center gap-3 mb-6">
      <span class="text-xs font-mono px-2 py-0.5 rounded" style="background:var(--bg-3);color:var(--accent);">Style A</span>
      <h2 class="text-base font-semibold" style="color: var(--text-heading);">그리드 카드</h2>
      <span class="text-xs" style="color:var(--text-muted);">카테고리별 기술 카드 모음</span>
    </div>
    <div class="grid md:grid-cols-2 gap-5">
      {Object.entries(techData).map(([group, items]) => (
        <div class="rounded-xl p-5" style={`background: var(--bg-2); border: 1px solid var(--border); box-shadow: var(--card-shadow);`}>
          <div class="flex items-center gap-2 mb-4">
            <span class="w-2 h-2 rounded-full" style={`background: ${groupMeta[group].color}`}></span>
            <span class="text-xs font-bold tracking-widest uppercase" style={`color: ${groupMeta[group].color}`}>{groupMeta[group].label}</span>
          </div>
          <div class="space-y-3">
            {items.map(t => (
              <div class="flex items-center gap-3">
                <span class="w-8 h-8 rounded-lg flex items-center justify-center text-sm font-mono flex-shrink-0"
                  style={`background: ${groupMeta[group].color}18; color: ${groupMeta[group].color};`}>{t.icon}</span>
                <div class="min-w-0">
                  <div class="text-sm font-semibold" style="color: var(--text-heading);">{t.name}</div>
                  <div class="text-xs truncate" style="color: var(--text-muted);">{t.desc}</div>
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ── 스타일 B: 숙련도 바 ── -->
  <section class="mb-16">
    <div class="flex items-center gap-3 mb-6">
      <span class="text-xs font-mono px-2 py-0.5 rounded" style="background:var(--bg-3);color:var(--accent);">Style B</span>
      <h2 class="text-base font-semibold" style="color: var(--text-heading);">숙련도 바</h2>
      <span class="text-xs" style="color:var(--text-muted);">기술별 숙련도 시각화</span>
    </div>
    <div class="grid md:grid-cols-2 gap-5">
      {Object.entries(techData).map(([group, items]) => (
        <div class="rounded-xl p-5" style={`background: var(--bg-2); border: 1px solid var(--border); box-shadow: var(--card-shadow);`}>
          <div class="flex items-center gap-2 mb-4">
            <span class="w-2 h-2 rounded-full" style={`background: ${groupMeta[group].color}`}></span>
            <span class="text-xs font-bold tracking-widest uppercase" style={`color: ${groupMeta[group].color}`}>{groupMeta[group].label}</span>
          </div>
          <div class="space-y-3">
            {items.map(t => (
              <div>
                <div class="flex items-center justify-between mb-1">
                  <div class="flex items-center gap-2">
                    <span class="text-sm font-mono" style={`color: ${groupMeta[group].color}`}>{t.icon}</span>
                    <span class="text-sm font-medium" style="color: var(--text-heading);">{t.name}</span>
                  </div>
                  <span class="text-xs font-mono" style="color: var(--text-muted);">{t.level}%</span>
                </div>
                <div class="h-1.5 rounded-full overflow-hidden" style="background: var(--bg-3);">
                  <div class="h-full rounded-full transition-all duration-700"
                    style={`width: ${t.level}%; background: ${groupMeta[group].color};`}></div>
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ── 스타일 C: 배지 태그 클라우드 ── -->
  <section class="mb-16">
    <div class="flex items-center gap-3 mb-6">
      <span class="text-xs font-mono px-2 py-0.5 rounded" style="background:var(--bg-3);color:var(--accent);">Style C</span>
      <h2 class="text-base font-semibold" style="color: var(--text-heading);">배지 태그 클라우드</h2>
      <span class="text-xs" style="color:var(--text-muted);">카테고리 필터 + pill 배지</span>
    </div>
    <div id="badge-cloud" class="rounded-xl p-6" style="background: var(--bg-2); border: 1px solid var(--border); box-shadow: var(--card-shadow);">
      <!-- 필터 탭 -->
      <div class="flex flex-wrap gap-2 mb-5">
        <button data-filter="all"
          class="badge-filter text-xs px-3 py-1 rounded-full font-medium transition-all"
          style="background: var(--accent); color: #fff;">All</button>
        {Object.entries(groupMeta).map(([group, meta]) => (
          <button data-filter={group}
            class="badge-filter text-xs px-3 py-1 rounded-full font-medium transition-all"
            style={`background: ${meta.color}18; color: ${meta.color};`}>{meta.label}</button>
        ))}
      </div>
      <!-- 배지들 -->
      <div class="flex flex-wrap gap-2">
        {Object.entries(techData).map(([group, items]) =>
          items.map(t => (
            <span data-group={group}
              class="badge-item inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-sm font-medium transition-all"
              style={`background: ${groupMeta[group].color}15; color: ${groupMeta[group].color}; border: 1px solid ${groupMeta[group].color}30;`}>
              <span class="font-mono text-xs">{t.icon}</span>{t.name}
            </span>
          ))
        )}
      </div>
    </div>
  </section>

  <!-- ── 스타일 D: 아이콘 리스트 ── -->
  <section class="mb-16">
    <div class="flex items-center gap-3 mb-6">
      <span class="text-xs font-mono px-2 py-0.5 rounded" style="background:var(--bg-3);color:var(--accent);">Style D</span>
      <h2 class="text-base font-semibold" style="color: var(--text-heading);">아이콘 리스트</h2>
      <span class="text-xs" style="color:var(--text-muted);">카테고리 섹션별 아이콘 + 설명 목록</span>
    </div>
    <div class="grid md:grid-cols-2 gap-5">
      {Object.entries(techData).map(([group, items]) => (
        <div>
          <div class="flex items-center gap-2 mb-3">
            <div class="w-1 h-4 rounded-full" style={`background: ${groupMeta[group].color}`}></div>
            <span class="text-sm font-bold" style={`color: ${groupMeta[group].color}`}>{groupMeta[group].label}</span>
          </div>
          <div class="space-y-1">
            {items.map(t => (
              <div class="flex items-center gap-3 px-3 py-2 rounded-lg transition-colors group"
                style="background: transparent;"
                onmouseover={`this.style.background='var(--bg-3)'`}
                onmouseout={`this.style.background='transparent'`}>
                <span class="w-7 h-7 rounded-md flex items-center justify-center text-xs font-mono flex-shrink-0"
                  style={`background: ${groupMeta[group].color}18; color: ${groupMeta[group].color};`}>{t.icon}</span>
                <div class="flex-1 min-w-0">
                  <span class="text-sm font-medium" style="color: var(--text-heading);">{t.name}</span>
                  <span class="text-xs ml-2" style="color: var(--text-muted);">{t.desc}</span>
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- 선택 안내 -->
  <div class="rounded-xl p-4 text-sm text-center" style="background: var(--bg-3); color: var(--text-muted); border: 1px dashed var(--border);">
    마음에 드는 스타일을 알려주시면 해당 스타일로 확정하고 나머지를 제거합니다
  </div>

</BaseLayout>

<script>
  // Style C — 배지 필터
  const filters = document.querySelectorAll('.badge-filter');
  const badges  = document.querySelectorAll('.badge-item');

  filters.forEach(btn => {
    btn.addEventListener('click', () => {
      const target = btn.dataset.filter;

      filters.forEach(b => {
        const group = b.dataset.filter;
        const meta = {
          all:      { bg: 'var(--accent)',        color: '#fff' },
          frontend: { bg: '#6366f118',            color: '#6366f1' },
          backend:  { bg: '#10b98118',            color: '#10b981' },
          infra:    { bg: '#f59e0b18',            color: '#f59e0b' },
          ai:       { bg: '#ec489918',            color: '#ec4899' },
        };
        if (b === btn) {
          b.style.background = group === 'all' ? 'var(--accent)' : meta[group].bg.replace('18', '');
          b.style.color = group === 'all' ? '#fff' : '#fff';
          b.style.opacity = '1';
        } else {
          const m = meta[group] || meta.all;
          b.style.background = m.bg;
          b.style.color = m.color;
          b.style.opacity = '0.6';
        }
      });

      badges.forEach(badge => {
        if (target === 'all' || badge.dataset.group === target) {
          badge.style.opacity = '1';
          badge.style.transform = 'scale(1)';
        } else {
          badge.style.opacity = '0.2';
          badge.style.transform = 'scale(0.95)';
        }
      });
    });
  });
</script>
