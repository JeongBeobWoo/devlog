---
import BaseLayout from '../layouts/BaseLayout.astro';
import TechGraph from '../components/TechGraph.astro';
---

<BaseLayout title="Tech Map" description="사용 기술들의 관계와 아키텍처 흐름을 시각화합니다">
  <div class="mb-8">
    <h1 class="text-2xl font-bold text-white mb-2">Tech Map</h1>
    <p class="text-sm" style="color: var(--text-muted);">사용 기술들의 관계와 아키텍처 흐름 · 드래그 이동 · 스크롤 확대/축소</p>
  </div>

  <TechGraph />

  <!-- Legend -->
  <div class="mt-8 flex flex-wrap gap-4 text-sm">
    {[
      { group: 'frontend', color: '#6366f1', label: 'Frontend' },
      { group: 'backend',  color: '#10b981', label: 'Backend' },
      { group: 'infra',    color: '#f59e0b', label: 'Infra' },
      { group: 'ai',       color: '#ec4899', label: 'AI / API' },
      { group: 'tool',     color: '#8b5cf6', label: 'Tools' },
    ].map(({ color, label }) => (
      <div class="flex items-center gap-2">
        <span class="w-3 h-3 rounded-full" style={`background: ${color}`}></span>
        <span style="color: var(--text-muted);">{label}</span>
      </div>
    ))}
  </div>

  <!-- Description -->
  <div class="mt-10 grid md:grid-cols-2 gap-4">
    {[
      {
        title: '프론트엔드 스택',
        color: '#6366f1',
        items: ['React — 컴포넌트 기반 UI 라이브러리', 'Next.js — SSR/SSG 풀스택 프레임워크', 'TypeScript — 정적 타입으로 안정성 확보', 'Tailwind — 유틸리티 CSS', 'Astro — 이 블로그 포함 정적 사이트']
      },
      {
        title: '백엔드 스택',
        color: '#10b981',
        items: ['Node.js — JS 서버 런타임', 'FastAPI — Python 비동기 API 서버', 'PostgreSQL — 주요 관계형 데이터베이스', 'Redis — 캐시 및 작업 큐']
      },
      {
        title: '인프라',
        color: '#f59e0b',
        items: ['Docker — 모든 서비스 컨테이너화', 'Nginx — 리버스 프록시, SSL 터미네이션', 'GitHub Actions — CI/CD 자동화']
      },
      {
        title: 'AI / 자동화',
        color: '#ec4899',
        items: ['Claude API — 텍스트 생성 및 분석', 'Gemini API — 이미지 생성', 'Playwright — 브라우저 자동화, 스크래핑']
      },
    ].map(({ title, color, items }) => (
      <div class="card">
        <h3 class="font-semibold mb-3 text-sm" style={`color: ${color}`}>{title}</h3>
        <ul class="space-y-1.5">
          {items.map(item => (
            <li class="text-sm" style="color: var(--text-muted);">· {item}</li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</BaseLayout>
