---
export const prerender = false;

import { execSync } from 'child_process';
import path from 'path';
import fs from 'fs';

let result = { success: false, message: '', slug: '' };

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const title       = form.get('title')?.toString().trim() ?? '';
  const description = form.get('description')?.toString().trim() ?? '';
  const date        = form.get('date')?.toString() ?? new Date().toISOString().slice(0, 10);
  const category    = form.get('category')?.toString().trim() ?? '';
  const tags        = form.get('tags')?.toString().trim() ?? '';
  const techs       = form.get('techs')?.toString().trim() ?? '';
  const seoTitle    = form.get('seoTitle')?.toString().trim() ?? '';
  const seoDescription = form.get('seoDescription')?.toString().trim() ?? '';
  const content     = form.get('content')?.toString() ?? '';
  const slug        = form.get('slug')?.toString().trim()
    || title.toLowerCase().replace(/[^a-z0-9가-힣]+/g, '-').replace(/^-|-$/g, '');

  const tagsArr  = tags  ? tags.split(',').map(t  => `"${t.trim()}"`).join(', ')  : '';
  const techsArr = techs ? techs.split(',').map(t => `"${t.trim()}"`).join(', ') : '';

  const frontmatter = `---
title: "${title}"
description: "${description}"
date: "${date}"
${category ? `category: "${category}"` : ''}
tags: [${tagsArr}]
techs: [${techsArr}]
${seoTitle ? `seoTitle: "${seoTitle}"` : ''}
${seoDescription ? `seoDescription: "${seoDescription}"` : ''}
---

${content}`;

  try {
    const repoRoot = process.cwd();
    const filePath = path.join(repoRoot, 'src/content/posts', `${slug}.md`);
    fs.writeFileSync(filePath, frontmatter, 'utf-8');

    const gitEnv = { ...process.env, GIT_SSH_COMMAND: 'ssh -o StrictHostKeyChecking=no' };
    execSync(`git add src/content/posts/${slug}.md`, { cwd: repoRoot, env: gitEnv });
    execSync(`git commit -m "post: ${title}"`, { cwd: repoRoot, env: gitEnv });
    execSync('git push origin main', { cwd: repoRoot, env: gitEnv });

    result = { success: true, message: '발행됐습니다. 배포까지 1~2분 소요됩니다.', slug };
  } catch (e: any) {
    result = { success: false, message: `오류: ${e.message}`, slug: '' };
  }
}

const today = new Date().toISOString().slice(0, 10);
---

<!doctype html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>글 작성 — Admin</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@600;700&family=IBM+Plex+Sans+KR:wght@400;500&family=JetBrains+Mono:wght@400;500&display=swap" />
  <style>
    :root {
      --bg:#0f0f13; --bg-2:#16161d; --bg-3:#1e1e2a; --border:#2a2a3a;
      --text:#e2e2f0; --text-heading:#ffffff; --text-muted:#8888aa;
      --accent:#6366f1; --accent-glow:rgba(99,102,241,.3);
      --code-color:#a78bfa; --card-shadow:none;
      --font-body:'IBM Plex Sans KR','Inter',sans-serif;
      --font-heading:'Space Grotesk','Inter',sans-serif;
    }
    html.light {
      --bg:#ffffff; --bg-2:#ffffff; --bg-3:#eef2ff; --border:#e4e4e7;
      --text:#18181b; --text-heading:#18181b; --text-muted:#71717a;
      --accent:#4f46e5; --accent-glow:rgba(79,70,229,.08);
      --code-color:#4f46e5; --card-shadow:0 1px 3px rgba(0,0,0,.04);
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background: var(--bg);
      color: var(--text);
      font-family: var(--font-body, 'Inter', sans-serif);
      min-height: 100vh;
      -webkit-font-smoothing: antialiased;
    }

    .adm-header {
      position: sticky; top: 0; z-index: 50;
      background: var(--bg-2);
      border-bottom: 1px solid var(--border);
      padding: 0 1.5rem;
      height: 3.5rem;
      display: flex; align-items: center; justify-content: space-between;
    }
    .adm-logo { font-family: monospace; font-size: 0.875rem; color: var(--accent); display: flex; align-items: center; gap: 0.75rem; }
    .adm-logo a { color: var(--text-muted); text-decoration: none; font-size: 0.8rem; transition: color .2s; }
    .adm-logo a:hover { color: var(--text-heading); }

    .actions { display: flex; gap: 0.75rem; align-items: center; }

    .toast { padding: 0.5rem 0.875rem; border-radius: 0.5rem; font-size: 0.8rem; font-weight: 500; }
    .toast.success { background: #052e16; color: #4ade80; border: 1px solid #166534; }
    .toast.error   { background: #2d0a0a; color: #f87171; border: 1px solid #7f1d1d; }

    .btn-publish {
      padding: 0.4rem 1.1rem;
      background: var(--accent); color: #fff;
      border: none; border-radius: 0.5rem;
      font-size: 0.875rem; font-weight: 500; cursor: pointer;
      transition: opacity .2s;
    }
    .btn-publish:hover { opacity: .85; }

    /* 레이아웃 */
    .layout { display: grid; grid-template-columns: 1fr 1fr; height: calc(100vh - 3.5rem); }
    .editor-panel { padding: 1.25rem 1.5rem; overflow-y: auto; border-right: 1px solid var(--border); display: flex; flex-direction: column; gap: 0.875rem; }
    .preview-panel { padding: 1.5rem; overflow-y: auto; background: var(--bg-2); }

    /* 폼 요소 */
    .field label {
      display: block; font-size: 0.7rem; font-family: 'JetBrains Mono', monospace;
      color: var(--text-muted); margin-bottom: 0.4rem; text-transform: uppercase; letter-spacing: .06em; font-weight: 600;
    }
    .field input {
      width: 100%;
      background: var(--bg-3); border: 1px solid var(--border);
      border-radius: 0.625rem; color: var(--text);
      font-size: 0.925rem; padding: 0.6rem 0.875rem;
      outline: none; transition: border-color .2s, box-shadow .2s; font-family: inherit;
    }
    .field input:focus { border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-glow); }
    .field input::placeholder { color: var(--text-muted); opacity: .55; }
    .row2 { display: grid; grid-template-columns: 1fr 1fr; gap: 0.875rem; }

    /* SEO 접기 */
    details summary {
      font-size: 0.72rem; font-family: 'JetBrains Mono', monospace; color: var(--text-muted);
      cursor: pointer; text-transform: uppercase; letter-spacing: .06em;
      padding: 0.5rem 0.25rem; user-select: none; font-weight: 600;
    }
    .seo-inner {
      display: flex; flex-direction: column; gap: 0.75rem;
      margin-top: 0.5rem; padding: 1rem;
      background: var(--bg-3); border: 1px solid var(--border); border-radius: 0.625rem;
    }

    /* 리치 에디터 */
    .editor-wrap { flex: 1; display: flex; flex-direction: column; border: 1.5px solid var(--border); border-radius: 0.625rem; overflow: hidden; transition: border-color .2s, box-shadow .2s; }
    .editor-wrap:focus-within { border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-glow); }

    .toolbar {
      display: flex; flex-wrap: wrap; gap: 3px;
      padding: 0.5rem 0.625rem;
      background: var(--bg-3); border-bottom: 1px solid var(--border);
    }
    .tb-btn {
      padding: 0.3rem 0.6rem;
      background: none; border: 1px solid transparent; border-radius: 0.375rem;
      color: var(--text-muted); font-size: 0.82rem; cursor: pointer;
      transition: all .15s; font-family: 'JetBrains Mono', monospace; line-height: 1.4; font-weight: 500;
    }
    .tb-btn:hover { background: var(--bg-2); border-color: var(--border); color: var(--text-heading); }
    .tb-sep { width: 1px; background: var(--border); margin: 3px 4px; align-self: stretch; }

    #editor {
      flex: 1; min-height: 380px;
      padding: 1.125rem 1.25rem;
      outline: none;
      font-size: 0.975rem; line-height: 1.85;
      color: var(--text);
      background: var(--bg-2);
      overflow-y: auto;
    }
    #editor:empty::before { content: attr(data-placeholder); color: var(--text-muted); opacity: .5; pointer-events: none; }

    /* 에디터 내 서식 */
    #editor h1 { font-size: 1.5rem; font-weight: 700; margin: 1rem 0 .5rem; color: var(--text-heading); border-bottom: 1px solid var(--border); padding-bottom: .375rem; }
    #editor h2 { font-size: 1.2rem; font-weight: 700; margin: .875rem 0 .4rem; color: var(--text-heading); }
    #editor h3 { font-size: 1.05rem; font-weight: 600; margin: .75rem 0 .35rem; color: var(--text-heading); }
    #editor p  { margin-bottom: .625rem; }
    #editor strong { color: var(--text-heading); }
    #editor em { font-style: italic; }
    #editor code { background: var(--bg-3); padding: .1rem .35rem; border-radius: .25rem; font-family: monospace; font-size: .85em; color: var(--code-color); border: 1px solid var(--border); }
    #editor pre { background: var(--bg-3); border: 1px solid var(--border); border-radius: .5rem; padding: .875rem 1rem; margin: .625rem 0; overflow-x: auto; }
    #editor pre code { background: none; border: none; padding: 0; }
    #editor blockquote { border-left: 3px solid var(--accent); padding-left: .875rem; margin: .625rem 0; color: var(--text-muted); }
    #editor ul, #editor ol { padding-left: 1.5rem; margin-bottom: .625rem; }
    #editor li { margin-bottom: .2rem; }
    #editor a { color: var(--accent); }
    #editor hr { border: none; border-top: 1px solid var(--border); margin: 1rem 0; }

    /* 숨겨진 textarea (폼 제출용) */
    #content { display: none; }

    /* 미리보기 */
    .preview-panel h1, .preview-panel h2, .preview-panel h3 { color: var(--text-heading); margin: 1.25rem 0 .5rem; }
    .preview-panel h1 { font-size: 1.4rem; border-bottom: 1px solid var(--border); padding-bottom: .4rem; }
    .preview-panel h2 { font-size: 1.15rem; }
    .preview-panel p  { color: var(--text); line-height: 1.75; margin-bottom: .75rem; }
    .preview-panel code { background: var(--bg-3); padding: .1rem .35rem; border-radius: .25rem; font-size: .8rem; color: var(--code-color); font-family: monospace; }
    .preview-panel pre { background: var(--bg-3); border: 1px solid var(--border); border-radius: .5rem; padding: 1rem; overflow-x: auto; margin-bottom: 1rem; }
    .preview-panel pre code { background: none; padding: 0; }
    .preview-panel ul, .preview-panel ol { color: var(--text); padding-left: 1.5rem; margin-bottom: .75rem; line-height: 1.75; }
    .preview-panel blockquote { border-left: 3px solid var(--accent); padding-left: 1rem; color: var(--text-muted); margin: .75rem 0; }
    .preview-placeholder { color: var(--border); font-size: .875rem; margin-top: 4rem; text-align: center; }

    @media (max-width: 768px) {
      .layout { grid-template-columns: 1fr; }
      .preview-panel { display: none; }
      .preview-panel.visible { display: block; height: calc(100vh - 3.5rem); }
    }
  </style>
  <script is:inline>
    if (localStorage.getItem('theme') === 'light') document.documentElement.classList.add('light');
  </script>
</head>
<body>
  <header class="adm-header">
    <div class="adm-logo">
      <span>◆ 글 작성</span>
      <a href="/admin">← 대시보드</a>
    </div>
    <div class="actions">
      {result.success && <span class="toast success">{result.message}</span>}
      {!result.success && result.message && <span class="toast error">{result.message}</span>}
      <button type="button" class="btn-publish" style="background:none;border:1px solid var(--border);color:var(--text-muted);" onclick="togglePreview()">미리보기</button>
      <button type="submit" form="write-form" class="btn-publish" onclick="syncContent()">발행</button>
    </div>
  </header>

  <div class="layout">
    <!-- 에디터 패널 -->
    <div class="editor-panel">
      <form id="write-form" method="POST">

        <div class="field">
          <label for="title">제목 *</label>
          <input id="title" name="title" type="text" placeholder="글 제목" required />
        </div>

        <div class="field">
          <label for="description">한 줄 설명 *</label>
          <input id="description" name="description" type="text" placeholder="목록에 표시될 설명" required />
        </div>

        <div class="row2">
          <div class="field">
            <label for="date">날짜</label>
            <input id="date" name="date" type="date" value={today} />
          </div>
          <div class="field">
            <label for="category">카테고리</label>
            <input id="category" name="category" type="text" placeholder="개발, 회고..." />
          </div>
        </div>

        <div class="row2">
          <div class="field">
            <label for="tags">태그 (쉼표 구분)</label>
            <input id="tags" name="tags" type="text" placeholder="React, TypeScript" />
          </div>
          <div class="field">
            <label for="techs">기술 (쉼표 구분)</label>
            <input id="techs" name="techs" type="text" placeholder="React, Node.js" />
          </div>
        </div>

        <details>
          <summary>SEO 설정 (선택)</summary>
          <div class="seo-inner">
            <div class="field">
              <label for="seoTitle">SEO 제목</label>
              <input id="seoTitle" name="seoTitle" type="text" placeholder="비워두면 제목과 동일" />
            </div>
            <div class="field">
              <label for="seoDescription">SEO 설명</label>
              <input id="seoDescription" name="seoDescription" type="text" placeholder="비워두면 한 줄 설명과 동일" />
            </div>
            <div class="field">
              <label for="slug">슬러그 (URL)</label>
              <input id="slug" name="slug" type="text" placeholder="자동 생성" />
            </div>
          </div>
        </details>

        <!-- 리치 에디터 -->
        <div class="editor-wrap">
          <div class="toolbar">
            <button type="button" class="tb-btn" onclick="fmt('bold')" title="굵게"><b>B</b></button>
            <button type="button" class="tb-btn" onclick="fmt('italic')" title="기울기"><i>I</i></button>
            <button type="button" class="tb-btn" onclick="fmt('strikeThrough')" title="취소선"><s>S</s></button>
            <div class="tb-sep"></div>
            <button type="button" class="tb-btn" onclick="heading(1)" title="제목 1">H1</button>
            <button type="button" class="tb-btn" onclick="heading(2)" title="제목 2">H2</button>
            <button type="button" class="tb-btn" onclick="heading(3)" title="제목 3">H3</button>
            <div class="tb-sep"></div>
            <button type="button" class="tb-btn" onclick="fmt('insertUnorderedList')" title="불릿 목록">• 목록</button>
            <button type="button" class="tb-btn" onclick="fmt('insertOrderedList')" title="번호 목록">1. 목록</button>
            <div class="tb-sep"></div>
            <button type="button" class="tb-btn" onclick="insertBlockquote()" title="인용">❝ 인용</button>
            <button type="button" class="tb-btn" onclick="insertCode()" title="인라인 코드">`코드`</button>
            <button type="button" class="tb-btn" onclick="insertCodeBlock()" title="코드 블록">``` 블록</button>
            <div class="tb-sep"></div>
            <button type="button" class="tb-btn" onclick="insertLink()" title="링크">🔗 링크</button>
            <button type="button" class="tb-btn" onclick="insertHr()" title="구분선">— 구분선</button>
          </div>
          <div
            id="editor"
            contenteditable="true"
            data-placeholder="본문을 작성하세요..."
            oninput="syncPreview()"
          ></div>
        </div>

        <!-- 폼 제출용 hidden textarea -->
        <textarea id="content" name="content"></textarea>

      </form>
    </div>

    <!-- 미리보기 패널 -->
    <div class="preview-panel" id="preview-panel">
      <div id="preview-content">
        <p class="preview-placeholder">본문을 작성하면 미리보기가 표시됩니다</p>
      </div>
    </div>
  </div>

  <script type="module">
    import { marked } from 'https://cdn.jsdelivr.net/npm/marked@12/+esm';
    import TurndownService from 'https://cdn.jsdelivr.net/npm/turndown@7/+esm';

    const editor  = document.getElementById('editor');
    const preview = document.getElementById('preview-content');
    const td      = new TurndownService({ headingStyle: 'atx', codeBlockStyle: 'fenced' });

    // ── 미리보기 동기화 ──────────────────────────────────────────────────────
    window.syncPreview = function() {
      const md = td.turndown(editor.innerHTML);
      preview.innerHTML = md.trim()
        ? marked.parse(md)
        : '<p class="preview-placeholder">본문을 작성하면 미리보기가 표시됩니다</p>';
    };

    // ── 발행 전 markdown 변환 ───────────────────────────────────────────────
    window.syncContent = function() {
      document.getElementById('content').value = td.turndown(editor.innerHTML);
    };

    // ── 서식 명령 ────────────────────────────────────────────────────────────
    window.fmt = (cmd) => { document.execCommand(cmd, false); editor.focus(); syncPreview(); };

    window.heading = (level) => {
      const tag = `h${level}`;
      const sel = window.getSelection();
      if (!sel.rangeCount) return;
      const range = sel.getRangeAt(0);
      const block = range.commonAncestorContainer.nodeType === 3
        ? range.commonAncestorContainer.parentElement
        : range.commonAncestorContainer;
      const cur = block.closest('h1,h2,h3,p,div');
      if (cur && cur.tagName.toLowerCase() === tag) {
        document.execCommand('formatBlock', false, 'p');
      } else {
        document.execCommand('formatBlock', false, tag);
      }
      editor.focus(); syncPreview();
    };

    window.insertBlockquote = () => {
      document.execCommand('formatBlock', false, 'blockquote');
      editor.focus(); syncPreview();
    };

    window.insertCode = () => {
      const sel = window.getSelection();
      const text = sel.toString();
      if (text) {
        const code = document.createElement('code');
        code.textContent = text;
        const range = sel.getRangeAt(0);
        range.deleteContents();
        range.insertNode(code);
      }
      editor.focus(); syncPreview();
    };

    window.insertCodeBlock = () => {
      const pre  = document.createElement('pre');
      const code = document.createElement('code');
      const sel  = window.getSelection();
      code.textContent = sel.toString() || '코드를 입력하세요';
      pre.appendChild(code);
      const range = sel.getRangeAt(0);
      range.deleteContents();
      range.insertNode(pre);
      // pre 뒤에 빈 p 추가
      const p = document.createElement('p');
      p.innerHTML = '<br>';
      pre.after(p);
      editor.focus(); syncPreview();
    };

    window.insertLink = () => {
      const url = prompt('URL 입력');
      if (url) { document.execCommand('createLink', false, url); editor.focus(); syncPreview(); }
    };

    window.insertHr = () => {
      document.execCommand('insertHTML', false, '<hr>');
      editor.focus(); syncPreview();
    };

    window.togglePreview = () => {
      document.getElementById('preview-panel').classList.toggle('visible');
    };
  </script>
</body>
</html>
