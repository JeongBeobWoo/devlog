---
export const prerender = false;

import { getCollection } from 'astro:content';

const posts = (await getCollection('posts'))
  .sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf());

const categories = [...new Set(posts.map(p => p.data.category).filter(Boolean))];
const allTags = [...new Set(posts.flatMap(p => p.data.tags ?? []))];
---

<!doctype html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Admin — DevLog</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { background: #0f0f13; color: #e2e2f0; font-family: 'Inter', sans-serif; min-height: 100vh; }
    .header {
      background: rgba(15,15,19,0.9);
      border-bottom: 1px solid #2a2a3a;
      padding: 0 1.5rem;
      height: 3.5rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: sticky;
      top: 0;
      z-index: 10;
    }
    .logo { font-family: monospace; font-size: 0.875rem; color: #6366f1; display: flex; align-items: center; gap: 0.5rem; }
    .logo a { color: #8888aa; text-decoration: none; font-size: 0.8rem; }
    .logo a:hover { color: #fff; }
    .header-right { display: flex; align-items: center; gap: 0.5rem; }
    .btn {
      padding: 0.375rem 0.875rem;
      border-radius: 0.5rem;
      font-size: 0.8rem;
      font-weight: 500;
      cursor: pointer;
      border: none;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      transition: all 0.2s;
      white-space: nowrap;
    }
    .btn-primary { background: #6366f1; color: #fff; }
    .btn-primary:hover { background: #4f46e5; }
    .btn-ghost { background: transparent; color: #8888aa; border: 1px solid #2a2a3a; }
    .btn-ghost:hover { border-color: #6366f1; color: #fff; }
    .btn-danger { background: transparent; color: #f87171; border: 1px solid #2a2a3a; }
    .btn-danger:hover { background: #7f1d1d22; border-color: #f87171; }

    main { max-width: 960px; margin: 0 auto; padding: 2rem 1.5rem; }
    h1 { font-size: 1.25rem; font-weight: 700; color: #fff; margin-bottom: 2rem; }

    .stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.75rem; margin-bottom: 2rem; }
    .stat-card { background: #16161d; border: 1px solid #2a2a3a; border-radius: 0.75rem; padding: 1rem 1.25rem; }
    .stat-label { font-size: 0.7rem; color: #8888aa; font-family: monospace; text-transform: uppercase; margin-bottom: 0.35rem; }
    .stat-value { font-size: 1.5rem; font-weight: 700; color: #fff; }

    .grid2 { display: grid; grid-template-columns: 1fr 280px; gap: 1.5rem; align-items: start; }

    .section-title { font-size: 0.8rem; font-weight: 600; color: #8888aa; font-family: monospace; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.75rem; }

    .post-list { display: flex; flex-direction: column; gap: 0.5rem; }
    .post-item {
      background: #16161d;
      border: 1px solid #2a2a3a;
      border-radius: 0.75rem;
      padding: 0.875rem 1rem;
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 0.75rem;
      align-items: center;
    }
    .post-item:hover { border-color: #6366f1; }
    .post-title {
      font-size: 0.875rem;
      font-weight: 500;
      color: #fff;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      margin-bottom: 0.25rem;
    }
    .post-meta { font-size: 0.7rem; color: #8888aa; font-family: monospace; display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; }
    .cat-badge { background: rgba(99,102,241,0.15); color: #818cf8; border: 1px solid rgba(99,102,241,0.3); border-radius: 0.25rem; padding: 0.05rem 0.4rem; font-size: 0.65rem; }
    .tag { background: #1e1e2a; border: 1px solid #2a2a3a; border-radius: 0.25rem; padding: 0.05rem 0.35rem; font-size: 0.65rem; color: #8888aa; }

    /* 사이드패널 */
    .side-section { background: #16161d; border: 1px solid #2a2a3a; border-radius: 0.75rem; padding: 1.25rem; margin-bottom: 1rem; }
    .side-section h3 { font-size: 0.75rem; font-weight: 600; color: #6366f1; font-family: monospace; text-transform: uppercase; margin-bottom: 0.875rem; }
    .cat-list { display: flex; flex-direction: column; gap: 0.4rem; }
    .cat-item { display: flex; align-items: center; justify-content: space-between; font-size: 0.8rem; }
    .cat-item span:first-child { color: #e2e2f0; }
    .cat-count { background: #1e1e2a; border: 1px solid #2a2a3a; border-radius: 0.25rem; padding: 0.05rem 0.4rem; font-size: 0.65rem; color: #8888aa; font-family: monospace; }
    .tag-cloud { display: flex; flex-wrap: wrap; gap: 0.4rem; }

    .new-post-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 0.75rem;
    }
  </style>
</head>
<body>
  <header class="header">
    <div class="logo">
      <span>◆ Admin</span>
      <span style="color:#2a2a3a">|</span>
      <a href="/" target="_blank">블로그 보기 →</a>
    </div>
    <div class="header-right">
      <a href="/admin/write" class="btn btn-primary">+ 새 글</a>
      <a href="/admin/settings" class="btn btn-ghost">설정</a>
      <form method="POST" action="/admin/logout" style="display:inline;">
        <button type="submit" class="btn btn-danger">로그아웃</button>
      </form>
    </div>
  </header>

  <main>
    <div class="stats">
      <div class="stat-card">
        <div class="stat-label">Total Posts</div>
        <div class="stat-value">{posts.length}</div>
      </div>
      <div class="stat-card">
        <div class="stat-label">Categories</div>
        <div class="stat-value">{categories.length}</div>
      </div>
      <div class="stat-card">
        <div class="stat-label">Tags</div>
        <div class="stat-value">{allTags.length}</div>
      </div>
      <div class="stat-card">
        <div class="stat-label">Latest</div>
        <div class="stat-value" style="font-size:0.9rem;padding-top:0.3rem;">
          {posts[0] ? new Date(posts[0].data.date).toLocaleDateString('ko-KR') : '—'}
        </div>
      </div>
    </div>

    <div class="grid2">
      <!-- 글 목록 -->
      <div>
        <div class="new-post-bar">
          <span class="section-title">Posts</span>
          <a href="/posts" target="_blank" class="btn btn-ghost" style="font-size:0.75rem;padding:0.25rem 0.625rem;">공개 보기</a>
        </div>
        <div class="post-list">
          {posts.map(post => (
            <div class="post-item">
              <div style="min-width:0;">
                <div class="post-title">{post.data.title}</div>
                <div class="post-meta">
                  <span>{new Date(post.data.date).toLocaleDateString('ko-KR')}</span>
                  {post.data.category && <span class="cat-badge">{post.data.category}</span>}
                  {(post.data.tags ?? []).slice(0,3).map((t: string) => <span class="tag">{t}</span>)}
                </div>
              </div>
              <a href={`/posts/${post.id}`} target="_blank"
                class="btn btn-ghost" style="font-size:0.7rem;padding:0.2rem 0.5rem;flex-shrink:0;">보기</a>
            </div>
          ))}
        </div>
      </div>

      <!-- 사이드 -->
      <div>
        <div class="side-section">
          <h3>Categories</h3>
          {categories.length > 0 ? (
            <div class="cat-list">
              {categories.map(cat => (
                <div class="cat-item">
                  <span>{cat}</span>
                  <span class="cat-count">{posts.filter(p => p.data.category === cat).length}</span>
                </div>
              ))}
            </div>
          ) : (
            <p style="font-size:0.75rem;color:#8888aa;">글 작성 시 카테고리를 설정하세요</p>
          )}
        </div>

        <div class="side-section">
          <h3>Tags</h3>
          <div class="tag-cloud">
            {allTags.map(tag => (
              <a href={`/tags/${tag}`} target="_blank" class="tag" style="text-decoration:none;">{tag}</a>
            ))}
          </div>
        </div>

        <div class="side-section">
          <h3>Quick Links</h3>
          <div style="display:flex;flex-direction:column;gap:0.4rem;">
            <a href="/admin/write" class="btn btn-primary" style="justify-content:center;">+ 새 글 작성</a>
            <a href="/admin/settings" class="btn btn-ghost" style="justify-content:center;">⚙ 설정 / 비밀번호</a>
            <a href="/tech" target="_blank" class="btn btn-ghost" style="justify-content:center;">◆ Tech Map</a>
          </div>
        </div>
      </div>
    </div>
  </main>
</body>
</html>
