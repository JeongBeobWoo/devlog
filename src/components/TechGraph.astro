---
const groups = [
  {
    id: 'frontend', label: 'Frontend', color: '#6366f1',
    items: [
      { icon: '⚛',  name: 'React' },
      { icon: '▲',  name: 'Next.js' },
      { icon: 'TS', name: 'TypeScript' },
      { icon: '💨', name: 'Tailwind' },
      { icon: '🚀', name: 'Astro' },
    ],
  },
  {
    id: 'backend', label: 'Backend', color: '#10b981',
    items: [
      { icon: '⬡',  name: 'Node.js' },
      { icon: 'FA', name: 'FastAPI' },
      { icon: 'PG', name: 'PostgreSQL' },
      { icon: '⚡', name: 'Redis' },
    ],
  },
  {
    id: 'infra', label: 'Infra', color: '#f59e0b',
    items: [
      { icon: '🐳', name: 'Docker' },
      { icon: 'NX', name: 'Nginx' },
      { icon: '⚙',  name: 'GitHub Actions' },
    ],
  },
  {
    id: 'ai', label: 'AI / Tools', color: '#ec4899',
    items: [
      { icon: '◆',  name: 'Claude API' },
      { icon: '✦',  name: 'Gemini API' },
      { icon: '🎭', name: 'Playwright' },
    ],
  },
];
---

<div class="grid sm:grid-cols-2 gap-3">
  {groups.map(group => (
    <div class="rounded-xl p-4" style={`background: var(--bg-2); border: 1px solid var(--border); box-shadow: var(--card-shadow);`}>
      <div class="flex items-center gap-2 mb-3">
        <span class="w-2 h-2 rounded-full flex-shrink-0" style={`background: ${group.color}`}></span>
        <span class="text-xs font-bold tracking-widest uppercase" style={`color: ${group.color}`}>{group.label}</span>
      </div>
      <div class="flex flex-wrap gap-1.5">
        {group.items.map(item => (
          <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-xs font-medium"
            style={`background: ${group.color}15; color: ${group.color}; border: 1px solid ${group.color}25;`}>
            <span class="font-mono">{item.icon}</span>
            {item.name}
          </span>
        ))}
      </div>
    </div>
  ))}
</div>
