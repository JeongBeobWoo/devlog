---
import BaseLayout from './BaseLayout.astro';
import Comments from '../components/Comments.astro';

interface Props {
  title: string;
  description?: string;
  date: string;
  tags?: string[];
  techs?: string[];
}

const { title, description, date, tags = [], techs = [] } = Astro.props;
const formatted = new Date(date).toLocaleDateString('ko-KR', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout title={title} description={description}>
  <article class="max-w-3xl mx-auto">
    <header class="mb-10">
      <div class="flex flex-wrap gap-2 mb-4">
        {tags.map(tag => (
          <a href={`/tags/${tag}`} class="tag-badge">{tag}</a>
        ))}
      </div>
      <h1 class="text-3xl font-bold mb-3 text-white">{title}</h1>
      <p class="text-sm" style="color: var(--text-muted);">{formatted}</p>
      {techs.length > 0 && (
        <div class="flex flex-wrap gap-2 mt-4">
          {techs.map(tech => (
            <span class="px-2 py-0.5 rounded-full text-xs font-mono" style="background: var(--accent-glow); color: var(--accent); border: 1px solid var(--accent);">{tech}</span>
          ))}
        </div>
      )}
    </header>

    <div class="prose-dark leading-7 space-y-4">
      <slot />
    </div>

    <footer class="mt-10">
      <a href="/posts" class="text-sm hover:text-white transition-colors" style="color: var(--text-muted);">← 모든 글 보기</a>
    </footer>

    <Comments />
  </article>
</BaseLayout>
